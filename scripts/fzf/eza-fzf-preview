#!/usr/bin/env zsh
# fzf-tab directory preview.
#
# Renders a small (2-level) TREE with the icon + name on the LEFT (dominant) and
# a dimmed "size  modified-date" right-aligned on each line, so names stay the
# focus. Hidden entries are included; .git / node_modules are shown but not
# expanded (noisy and rarely cd targets). Width comes from fzf's
# $FZF_PREVIEW_COLUMNS so the right edge always lines up with the preview pane.
#
# Tweak: DEPTH (tree levels), IGNORE (pruned globs), or the eza flags below.
# Usage: eza-fzf-preview <path>   (wired into the cd/z fzf-preview zstyles)
emulate -L zsh
setopt local_options extended_glob

local target=${1:a}
# Non-directories (safety): fall back to a plain colored listing.
[[ -d $target ]] || { eza -1 --color=always --icons=always -- "$target" 2>/dev/null; return; }

local cols=${FZF_PREVIEW_COLUMNS:-${COLUMNS:-60}}
local depth=2
local ignore='.git|node_modules'
local dim=$'\e[2m' rst=$'\e[0m'

# eza --tree needs the path as an ARGUMENT (relying on cwd yields no output when
# piped). Drop the root line (tail +2). Both passes use identical flags so the
# tree order matches line-for-line.
local -a names metas
# Left side: branch-art + icon + colored name.
names=( "${(@f)$(eza --tree --level=$depth -a --ignore-glob=$ignore \
        --color=always --icons=always -- "$target" 2>/dev/null | tail -n +2)}" )
# Right side: "size  iso-date" in the same order.
metas=( "${(@f)$(eza --tree --level=$depth -a --ignore-glob=$ignore \
        --color=never -l --no-permissions --no-user --time-style=long-iso \
        -- "$target" 2>/dev/null | tail -n +2 | awk '{printf "%s  %s %s\n", $1, $2, $3}')}" )

local i ncol meta vislen pad
for (( i=1; i<=$#names; i++ )); do
  ncol=$names[i]; meta=$metas[i]
  vislen=${#${(S)ncol//$'\e'\[[0-9;]#m/}}   # left width without ANSI codes
  pad=$(( cols - vislen - ${#meta} - 1 ))
  (( pad < 1 )) && pad=1
  printf '%s%*s%s%s%s\n' "$ncol" "$pad" "" "$dim" "$meta" "$rst"
done
